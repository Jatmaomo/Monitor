{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "fullName", "email", "createdAt"]
    },
    "Session": {
      "title": "Session",
      "description": "Camera pairing session and WebRTC signaling exchange",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "pairingCode": { "type": "string" },
        "cameraUserId": { "type": "string" },
        "monitorUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "connected", "disconnected"] },
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" }
      },
      "required": ["sessionId", "pairingCode", "cameraUserId", "status", "createdAt", "expiresAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "WebRTC camera session documents keyed by sessionId"
    },
    "/sessions/{sessionId}/cameraCandidates/{candidateId}": {
      "schema": "object",
      "description": "WebRTC ICE candidates sent from Camera phone"
    },
    "/sessions/{sessionId}/monitorCandidates/{candidateId}": {
      "schema": "object",
      "description": "WebRTC ICE candidates sent from Monitor phone"
    }
  }
}
